{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "apps/cli/src/**/*.ts", "apps/daemon/src/**/*.ts"],
  "exclude": ["src/presentation", "apps/desktop", "apps/web", "apps/android"]
}
