{
  "name": "hive-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:web": "electrobun prepare",
    "dev:web": "npm run prepare:web && npm run dev --workspace=hive-web",
    "build:web": "npm run build --workspace=hive-web",
    "dev:native": "node scripts/prebuild.mjs && electrobun dev",
    "build:native": "node scripts/prebuild.mjs && electrobun build --env=stable"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.9",
    "@lydell/node-pty": "^1.1.0",
    "react": "^19.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/ws": "^8.18.1",
    "electrobun": "2.0.1"
  }
}
