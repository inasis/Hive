{
  "name": "hive-codex-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Electrobun desktop and Android clients for AI coding provider sessions over Hive daemon, SSH, or relay connections.",
  "license": "BSD-2-Clause",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "hive": "dist/cli.js",
    "hive-codex": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "daemon:build": "tsc -p tsconfig.json",
    "daemon": "npm run daemon:build && node dist/cli.js daemon --mobile",
    "dev:app": "npm --prefix apps/desktop run dev:web",
    "build:app": "npm --prefix apps/desktop run build:web",
    "android:build": "bash scripts/build-android.sh",
    "desktop:dev": "npm --prefix apps/desktop run dev:native",
    "desktop:build": "npm --prefix apps/desktop run build:native"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "selfsigned": "^5.5.0"
  }
}
